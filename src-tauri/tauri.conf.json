{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumen",
  "version": "0.1.0",
  "identifier": "app.lumen.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:3847",
    "beforeBuildCommand": "npm run build && npm run lumen:standalone",
    "frontendDist": "../desktop-shell"
  },
  "app": {
    "windows": [
      {
        "title": "Lumen",
        "url": "http://127.0.0.1:3847",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "Lumen"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "Spanish"
        ]
      },
      "wix": {
        "language": "es-ES"
      }
    },
    "resources": {
      "../out-desktop/": "out-desktop/",
      "../scripts/windows/start-lumen-sidecar.ps1": "scripts/windows/start-lumen-sidecar.ps1"
    },
    "shortDescription": "Asistente local con Ollama",
    "longDescription": "Lumen es una aplicaci\u00f3n de escritorio Windows que responde con modelos locales en Ollama, documentos del usuario e internet opcional.",
    "publisher": "Lumen",
    "category": "Education"
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
