{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumen",
  "version": "0.1.0",
  "identifier": "app.lumen.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:3847",
    "beforeBuildCommand": "npm run build && npm run lumen:standalone",
    "frontendDist": "../out-desktop"
  },
  "app": {
    "windows": [
      {
        "title": "Lumen",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "Lumen"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["Spanish"]
      },
      "wix": {
        "language": "es-ES"
      }
    },
    "resources": ["../scripts/windows/start-lumen-sidecar.ps1"],
    "shortDescription": "Asistente local con Ollama",
    "longDescription": "Lumen es una aplicación de escritorio Windows que responde con modelos locales en Ollama, documentos del usuario e internet opcional.",
    "publisher": "Lumen",
    "category": "Education"
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
